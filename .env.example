# Copy to .env and set values. Never commit .env.
# Docker Compose uses this file (infra/compose/docker-compose.dev.yml).
#
# For native local development against an installed PostgreSQL instance,
# use .env.local instead (see .env.local.example and docs/development/local-postgres-setup.md).
# Do not point Docker Compose at .env.local unless you intentionally want that.

# PostgreSQL (Compose defaults)
RSREACH_DB_NAME=rsreach
RSREACH_DB_USER=rsreach
RSREACH_DB_PASSWORD=root
RSREACH_DB_PORT=5432

# Service ports
RSREACH_API_PORT=8080
RSREACH_WORKER_PORT=8081
RSREACH_SCHEDULER_PORT=8082
RSREACH_WEB_PORT=8088

# Database connection pools
RSREACH_API_DB_POOL_SIZE=10
RSREACH_API_DB_POOL_MIN_IDLE=2
RSREACH_WORKER_DB_POOL_SIZE=8
RSREACH_SCHEDULER_DB_POOL_SIZE=5

# Worker concurrency / polling
RSREACH_WORKER_CONCURRENCY=4
RSREACH_WORKER_CLAIM_BATCH_SIZE=20
RSREACH_WORKER_POLL_INTERVAL_MS=1000

# Scheduler
RSREACH_SCHEDULER_TICK_INTERVAL_MS=5000
RSREACH_SCHEDULER_BATCH_SIZE=100

# Security: must remain false outside local IDE runs.
RSREACH_SECURITY_PERMIT_UNAUTHENTICATED_API=false

# Dual-realm JWT secrets (min 32 characters each).
# Docker profile rejects blank values and any value starting with replace-with-.
# Copy this file to .env and substitute operator-generated secrets before compose up. Do not commit .env.
RSREACH_JWT_CUSTOMER_SECRET=
RSREACH_JWT_STAFF_SECRET=

# Optional first Platform Owner bootstrap (only when staff table empty)
RSREACH_BOOTSTRAP_STAFF_EMAIL=
RSREACH_BOOTSTRAP_STAFF_PASSWORD=

# Envelope encryption key management (required under docker profile; fail-fast if blank)
RSREACH_SECRETS_KEY_ALIAS=rsreach-master
RSREACH_SECRETS_KEY_VERSION=1
RSREACH_SECRETS_MASTER_KEY=
# RSREACH_SECRETS_MASTER_KEY_V2=

# Webhooks: keep false for Compose. Docker profile must not accept mock signatures.
# Local IDE runs that need mock-valid can set this true in .env.local only.
RSREACH_WEBHOOKS_ALLOW_MOCK_SIGNATURES=false

# Live providers (default false; do not invent credentials)
RSREACH_WHATSAPP_LIVE_ENABLED=false
RSREACH_WHATSAPP_APP_SECRET=
RSREACH_WHATSAPP_VERIFY_TOKEN=
RSREACH_EMAIL_DELIVERY_LIVE_ENABLED=false
RSREACH_MAILBOX_LIVE_ENABLED=false
RSREACH_EMAIL_SENDGRID_WEBHOOK_VERIFICATION_KEY=

# Razorpay webhook secret (required for docker-profile API; min 16 characters).
# Operator must set this in .env. Do not commit a real secret. Blank fails compose up.
RSREACH_RAZORPAY_WEBHOOK_SECRET=

# Media object store (ADR 0009 MinIO). Default off uses NoOpObjectStorage.
# Optional prod profile: docker compose -f infra/compose/docker-compose.prod.yml --profile media
# When object store is enabled, set access/secret to the MinIO root user/password (SigV4). Do not commit them.
RSREACH_MEDIA_OBJECT_STORE_ENABLED=false
RSREACH_MEDIA_MINIO_ENDPOINT=http://minio:9000
RSREACH_MEDIA_MINIO_BUCKET=rsreach-media
RSREACH_MEDIA_MINIO_ACCESS_KEY=
RSREACH_MEDIA_MINIO_SECRET_KEY=
RSREACH_MINIO_ROOT_USER=minioadmin
RSREACH_MINIO_ROOT_PASSWORD=

# Rate limit (auth + webhooks) per client IP per minute
RSREACH_SECURITY_RATE_LIMIT_PER_MINUTE=120
