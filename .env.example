# Copy to .env and set values. Never commit .env.

# PostgreSQL
RSREACH_DB_NAME=rsreach
RSREACH_DB_USER=rsreach
RSREACH_DB_PASSWORD=root
RSREACH_DB_PORT=5432

# Service ports
RSREACH_API_PORT=8080
RSREACH_WORKER_PORT=8081
RSREACH_SCHEDULER_PORT=8082
RSREACH_WEB_PORT=8088

# Database connection pools
RSREACH_API_DB_POOL_SIZE=10
RSREACH_API_DB_POOL_MIN_IDLE=2
RSREACH_WORKER_DB_POOL_SIZE=8
RSREACH_SCHEDULER_DB_POOL_SIZE=5

# Worker concurrency / polling
RSREACH_WORKER_CONCURRENCY=4
RSREACH_WORKER_CLAIM_BATCH_SIZE=20
RSREACH_WORKER_POLL_INTERVAL_MS=1000

# Scheduler
RSREACH_SCHEDULER_TICK_INTERVAL_MS=5000
RSREACH_SCHEDULER_BATCH_SIZE=100

# Security: must remain false outside local IDE runs.
RSREACH_SECURITY_PERMIT_UNAUTHENTICATED_API=false

# Dual-realm JWT secrets (min 32 characters each)
RSREACH_JWT_CUSTOMER_SECRET=replace-with-long-customer-jwt-secret-value
RSREACH_JWT_STAFF_SECRET=replace-with-long-staff-jwt-secret-value!!

# Optional first Platform Owner bootstrap (only when staff table empty)
RSREACH_BOOTSTRAP_STAFF_EMAIL=
RSREACH_BOOTSTRAP_STAFF_PASSWORD=

# Envelope encryption key management
RSREACH_SECRETS_KEY_ALIAS=rsreach-master
RSREACH_SECRETS_KEY_VERSION=1
RSREACH_SECRETS_MASTER_KEY=
# RSREACH_SECRETS_MASTER_KEY_V2=
