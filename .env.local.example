# Copy to .env.local (gitignored) for native local development against installed PostgreSQL.
# Do not commit .env.local.
#
#   Copy-Item .env.local.example .env.local
#
# Docker Compose continues to use .env (see .env.example). Keep the two files separate.

# --- Local PostgreSQL (native) ---
RSREACH_DB_NAME=rsreach_dev
RSREACH_DB_URL=jdbc:postgresql://localhost:5432/rsreach_dev
RSREACH_DB_USER=postgres
RSREACH_DB_PASSWORD=root
RSREACH_DB_PORT=5432

# --- Service ports ---
RSREACH_API_PORT=8080
RSREACH_WORKER_PORT=8081
RSREACH_SCHEDULER_PORT=8082

# --- Pools / worker ---
RSREACH_DB_POOL_SIZE=10
RSREACH_DB_POOL_MIN_IDLE=2
RSREACH_WORKER_CONCURRENCY=4
RSREACH_WORKER_CLAIM_BATCH_SIZE=20
RSREACH_WORKER_POLL_INTERVAL_MS=1000
RSREACH_SCHEDULER_TICK_INTERVAL_MS=5000
RSREACH_SCHEDULER_BATCH_SIZE=100

# --- Security (local IDE only) ---
RSREACH_SECURITY_PERMIT_UNAUTHENTICATED_API=false
RSREACH_SECURITY_EXPOSE_DEV_TOKENS=false

# Dual-realm JWT secrets (min 32 characters each) — local-only placeholders
RSREACH_JWT_CUSTOMER_SECRET=local-dev-customer-jwt-secret-value-32b
RSREACH_JWT_STAFF_SECRET=local-dev-staff-jwt-secret-value-32b!!!

# Optional first Platform Owner bootstrap (only when staff table empty)
RSREACH_BOOTSTRAP_STAFF_EMAIL=
RSREACH_BOOTSTRAP_STAFF_PASSWORD=

# Envelope encryption — local-only placeholder; rotate before any shared environment
RSREACH_SECRETS_KEY_ALIAS=rsreach-master
RSREACH_SECRETS_KEY_VERSION=1
RSREACH_SECRETS_MASTER_KEY=local-dev-master-key-material-do-not-use-elsewhere
